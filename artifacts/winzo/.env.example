# WINGGO — Firebase Web Config (public values, safe for client)
# Source: Firebase Console → Project Settings → General → Your apps → winggo-web → SDK setup and configuration
# Copy this file to ".env" and fill in the real values.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=winggo.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=winggo
VITE_FIREBASE_STORAGE_BUCKET=winggo.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_DATABASE_URL=
